# Copy to .env and edit as needed. Relative paths resolve against the project root.
PROJECT_NAME=Physical AI Driving Safety System
DATA_DIR=data
MODEL_DIR=models
OUTPUT_DIR=outputs
LOG_DIR=logs
# auto | cpu | cuda   (AMD ROCm builds of PyTorch also use "cuda")
DEVICE=auto
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# External local dataset root (NOT copied into the repo). Quote paths with spaces.
# Example (Windows, Google Drive for desktop): DATASET_ROOT="G:/My Drive/dataset"
DATASET_ROOT=

# --- Driver perception (PROTOTYPE defaults; not medically validated) ---
# MediaPipe Face Landmarker model, downloaded manually (see README)
FACE_MODEL_PATH=models/face/face_landmarker.task
MIN_FACE_CONFIDENCE=0.5
# Eye-aspect ratio below this counts as "closed" for a frame
EYE_CLOSURE_THRESHOLD=0.20
DROWSINESS_WINDOW_SECONDS=60
MIN_OBSERVED_SECONDS=5
MAX_GAP_SECONDS=0.5
BLINK_MAX_SECONDS=0.5
LONG_CLOSURE_SECONDS=1.0
SUSTAINED_CLOSURE_MAX_SECONDS=2.0
CLOSURE_RATIO_MAX=0.30
LONG_CLOSURE_EVENTS_MAX=3
CLOSURE_RATIO_WEIGHT=0.6
DROWSINESS_HIGH_THRESHOLD=0.5
DROWSINESS_CRITICAL_THRESHOLD=0.8
# Hand/activity states that count toward distraction_duration
DISTRACTION_STATES=NO_HANDS,PHONE,OTHER_MANUAL_DISTRACTION

# --- Hand-state classifier (trained on 188 images; prototype) ---
HAND_MODEL_PATH=outputs/models/hand_state_best.pt
# Max class probability below this -> hand_state UNKNOWN
HAND_CONFIDENCE_THRESHOLD=0.60
# NO_HANDS observed continuously this long -> inferred driver_activity HANDS_OFF_WHEEL
NO_HANDS_INFERENCE_SECONDS=2.0

# --- Front-camera road perception (pretrained Ultralytics YOLO; prototype defaults) ---
# Official weight names (e.g. yolo26n.pt) are downloaded once (~5.5 MB) if the file is missing
ROAD_MODEL_PATH=models/road/yolo26n.pt
# Detections below this confidence are dropped
ROAD_CONFIDENCE_THRESHOLD=0.35
# YOLO inference size (multiple of 32)
ROAD_IMAGE_SIZE=640
# Video frames per second (video time) sent to YOLO; 0 = every frame
ROAD_SAMPLE_FPS=5
# Optional device override for road perception (else DEVICE is used): auto | cpu | cuda
ROAD_DEVICE=
# Comma-separated COCO class names, or "all". Empty = road-relevant default set
ROAD_CLASSES=

# --- Road-object tracker (IoU; image-space only, prototype defaults) ---
# Same-class detection joins a track at this box overlap (IoU)
TRACK_IOU_THRESHOLD=0.3
# Different-class detection joins a track only at this overlap (YOLO label flicker); > 1 disables
TRACK_CLASS_SWITCH_IOU=0.6
# Unmatched tracks coast this long before they end
TRACK_MAX_MISSED_SECONDS=1.0
# Optional extra limit in processed frames (0 = none)
TRACK_MAX_MISSED_FRAMES=0

# --- Contextual risk engine (rule-based PROTOTYPE values; the score is not a probability) ---
# Any field of app/config/risk_config.py can be overridden as RISK_<FIELD>, for example:
# RISK_CAUTION_MIN=20
# RISK_HIGH_MIN=45
# RISK_CRITICAL_MIN=70
# RISK_HANDS_OFF_WHEEL_POINTS=25
# RISK_DROWSINESS_HIGH_POINTS=30
# RISK_ESCALATE_HIGH_OBSERVATIONS=2

# --- Event recorder / dataset (prototype defaults) ---
# Real (LOCAL_REAL / PUBLIC) and synthetic events are written to DIFFERENT roots
EVENT_EVENT_ROOT=data/events
EVENT_SYNTHETIC_ROOT=data/events_synthetic
EVENT_PERSISTENT_HAZARD_MIN_SECONDS=2.0
EVENT_HAZARD_COOLDOWN_SECONDS=10
EVENT_DRIVER_CHANGE_MIN_OBSERVATIONS=3
EVENT_DRIVER_CHANGE_COOLDOWN_SECONDS=5
# frame | clip | none   (clip = ring buffer, EVENT_EVIDENCE_PRE_SECONDS before + EVENT_EVIDENCE_POST_SECONDS after)
EVENT_EVIDENCE_MODE=frame
EVENT_EVIDENCE_PRE_SECONDS=5
EVENT_EVIDENCE_POST_SECONDS=5
